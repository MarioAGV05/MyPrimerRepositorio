import java.util.ArrayList;

public class Principal {

    public static void main(String[] args) {

        ArrayList<Telefono> lista = new ArrayList<>();

        // AGREGAR
        lista.add(new Telefono(1, "Samsung", "A54", "Negro", 8500));
        lista.add(new Telefono(2, "Apple", "iPhone 13", "Blanco", 18000));
        lista.add(new Telefono(3, "Xiaomi", "Redmi Note 12", "Azul", 6200));
        lista.add(new Telefono(4, "Motorola", "G Power", "Verde", 7000));
        lista.add(new Telefono(5, "Huawei", "P40", "Rojo", 9500));

        // MOSTRAR
        System.out.println("LISTA DE TELEFONOS");
        for (Telefono t : lista) {
            System.out.println(t);
        }

        // BUSCAR POR ID
        int idBuscar = 3;
        System.out.println("BUSCAR TELEFONO CON ID " + idBuscar);
        for (Telefono t : lista) {
            if (t.getId() == idBuscar) {
                System.out.println(t);
            }
        }

        // EDITAR
        int idEditar = 4;
        for (Telefono t : lista) {
            if (t.getId() == idEditar) {
                t.setColor("Negro");
                t.setCosto(7500);
            }
        }

        // ELIMINAR
        int idEliminar = 2;
        for (int i = 0; i < lista.size(); i++) {
            if (lista.get(i).getId() == idEliminar) {
                lista.remove(i);
                i--;
            }
        }

        // CONTAR
        System.out.println("TOTAL DE TELEFONOS: " + lista.size());

        // ELIMINAR TODO
        lista.clear();

        // VALIDAR
        if (lista.isEmpty()) {
            System.out.println("LA LISTA ESTA VACIA");
        } else {
            System.out.println("LA LISTA NO ESTA VACIA");
        }
    }
}