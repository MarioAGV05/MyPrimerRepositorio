package com.mx.TELEFONOS;

public class Telefonos {

    private int id;
    private String marca;
    private String modelo;
    private String color;
    private int costo;

    public Telefonos(int id, String marca, String modelo, String color, int costo) {
        this.id = id;
        this.marca = marca;
        this.modelo = modelo;
        this.color = color;
        this.costo = costo;
    }

    public int getId() {
        return id;
    }

    @Override
    public String toString() {
        return "ID: " + id +
               ", Marca: " + marca +
               ", Modelo: " + modelo +
               ", Color: " + color +
               ", Costo: $" + costo;
    }
}