package com.mx.TELEFONOS;

import java.util.ArrayList;
import java.util.Scanner;

public class Interactivo {

    public static void main(String[] args) {

        ArrayList<Telefonos> lista = new ArrayList<>();
        Scanner sc = new Scanner(System.in);
        int opcion;
        
        // AGREGAR
        lista.add(new Telefonos(1, "Samsung", "A54", "Negro", 8500));
        lista.add(new Telefonos(2, "Apple", "iPhone 13", "Blanco", 18000));
        lista.add(new Telefonos(3, "Xiaomi", "Redmi Note 12", "Azul", 6200));
        lista.add(new Telefonos(4, "Motorola", "G Power", "Verde", 7000));
        lista.add(new Telefonos(5, "Huawei", "P40", "Rojo", 9500));

        do {
            System.out.println("\n--- MENU TELEFONOS ---");
            System.out.println("1. Agregar");
            System.out.println("2. Mostrar");
            System.out.println("3. Buscar por marca");
            System.out.println("4. Editar por ID");
            System.out.println("5. Eliminar por marca");
            System.out.println("6. Contar");
            System.out.println("7. Eliminar todo");
            System.out.println("8. Salir");
            System.out.print("Opcion: ");
            opcion = sc.nextInt();
            sc.nextLine();

            switch (opcion) {

                case 1: // AGREGAR
                    System.out.print("ID: ");
                    int id = sc.nextInt();
                    sc.nextLine();

                    boolean existe = false;
                    for (Telefonos t : lista) {
                        if (t.getId() == id) {
                            existe = true;
                        }
                    }

                    if (existe) {
                        System.out.println("El telefono ya existe");
                    } else {
                        System.out.print("Marca: ");
                        String marca = sc.nextLine();
                        System.out.print("Modelo: ");
                        String modelo = sc.nextLine();
                        System.out.print("Color: ");
                        String color = sc.nextLine();
                        System.out.print("Costo: ");
                        int costo = sc.nextInt();
                        sc.nextLine();

                        lista.add(new Telefonos(id, marca, modelo, color, costo));
                        System.out.println("Telefono agregado");
                    }
                    break;

                case 2: // MOSTRAR
                    if (lista.isEmpty()) {
                        System.out.println("La lista esta vacia");
                    } else {
                        System.out.println("LISTA DE TELEFONOS");
                        for (Telefonos t : lista) {
                            System.out.println(t);
                        }
                    }
                    break;

                case 3: // BUSCAR POR MARCA
                    System.out.print("Marca a buscar: ");
                    String marcaBuscar = sc.nextLine();

                    boolean encontrado = false;
                    for (Telefonos t : lista) {
                        if (t.toString().toLowerCase().contains(marcaBuscar.toLowerCase())) {
                            System.out.println(t);
                            encontrado = true;
                        }
                    }

                    if (!encontrado) {
                        System.out.println("Ese telefono no existe en la lista");
                    }
                    break;

                case 4: // EDITAR POR ID
                    System.out.print("ID a editar: ");
                    int idEditar = sc.nextInt();
                    sc.nextLine();

                    boolean editado = false;

                    for (int i = 0; i < lista.size(); i++) {
                        if (lista.get(i).getId() == idEditar) {

                            System.out.println("ANTES DE EDITAR:");
                            System.out.println(lista.get(i));

                            System.out.print("Nueva marca: ");
                            String marca = sc.nextLine();

                            System.out.print("Nuevo modelo: ");
                            String modelo = sc.nextLine();

                            System.out.print("Nuevo color: ");
                            String color = sc.nextLine();

                            System.out.print("Nuevo costo: ");
                            int costo = sc.nextInt();
                            sc.nextLine();

                            lista.get(i).setMarca(marca);
                            lista.get(i).setModelo(modelo);
                            lista.get(i).setColor(color);
                            lista.get(i).setCosto(costo);

                            System.out.println("DESPUES DE EDITAR:");
                            System.out.println(lista.get(i));

                            editado = true;
                            break;
                        }
                    }

                    if (!editado) {
                        System.out.println("El telefono no existe");
                    }
                    break;

                case 5: // ELIMINAR POR MARCA
                    System.out.print("Marca a eliminar: ");
                    String marcaEliminar = sc.nextLine();

                    ArrayList<Telefonos> encontrados = new ArrayList<>();

                    for (Telefonos t : lista) {
                        if (t.toString().toLowerCase().contains(marcaEliminar.toLowerCase())) {
                            encontrados.add(t);
                        }
                    }

                    if (encontrados.isEmpty()) {
                        System.out.println("No hay telefonos con esa marca");
                    } else {
                        System.out.println("Telefonos encontrados:");
                        for (Telefonos t : encontrados) {
                            System.out.println(t);
                        }

                        System.out.print("ID a eliminar: ");
                        int idEliminar = sc.nextInt();
                        sc.nextLine();

                        for (int i = 0; i < lista.size(); i++) {
                            if (lista.get(i).getId() == idEliminar) {
                                lista.remove(i);
                                System.out.println("Telefono eliminado");
                                break;
                            }
                        }
                    }
                    break;

                case 6: // CONTAR
                    System.out.println("Total de telefonos: " + lista.size());
                    break;

                case 7: // ELIMINAR TODO
                    lista.clear();
                    System.out.println("Lista eliminada");
                    break;

                case 8:
                    System.out.println("Saliendo...");
                    break;

                default:
                    System.out.println("Opcion invalida, selecciona una opcion valida del menu");
            }

        } while (opcion != 8);

        sc.close();
    }
}